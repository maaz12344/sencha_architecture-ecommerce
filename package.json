{
  "name": "shop-sphere",
  "product": "ext",
  "version": "0.0.1",
  "description": "shop-sphere description for Ext JS app ShopSphere",
  "repository": {
    "type": "git",
    "url": "https://github.com/"
  },
  "keywords": [
    "Ext",
    "JS",
    "Sencha",
    "HTML5"
  ],
  "author": "Sencha, Inc.",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/"
  },
  "homepage": "http://www.sencha.com",
  "scripts": {
    "start": "npm run dev",
    "clean": "rimraf build",
    "dev": "webpack-dev-server --env profile=desktop --env browser=yes --env verbose=no",
    "build": "npm run clean && cross-env webpack --env profile=desktop --env environment=production --env treeshake=yes",
    "build:testing": "npm run clean && cross-env webpack --env profile=desktop --env treeshake=yes --env cmdopts=--testing",
    "postinstall": "npm prune"
  },
  "dependencies": {
    "@sencha/ext": "~8.1.0",
    "@sencha/ext-modern": "~8.1.0",
    "@sencha/ext-modern-theme-material": "~8.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.5.5",
    "@babel/core": "^7.5.5",
    "@babel/plugin-proposal-object-rest-spread": "^7.5.5",
    "@babel/plugin-transform-async-to-generator": "^7.5.0",
    "@babel/plugin-transform-regenerator": "^7.4.5",
    "@babel/preset-env": "^7.5.5",
    "@sencha/cmd": "^8.1.0",
    "@sencha/cmd-windows": "^8.1.0",
    "@sencha/ext-webpack-plugin": "~8.1.0",
    "babel-loader": "^8.0.6",
    "babel-plugin-add-module-exports": "^1.0.2",
    "cross-env": "^5.2.0",
    "lodash.find": "^4.6.0",
    "portfinder": "^1.0.21",
    "replace": "^1.1.1",
    "rimraf": "^3.0.2",
    "webpack": "^5.112.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.7"
  },
  "overrides": {
    "cross-spawn": "^7.0.6",
    "replace": {
      "minimatch": "^3.1.5"
    },
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "core-js": false,
    "fsevents": false
  }
}
